<Window x:Class="ARK.Charting.SymbolDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        mc:Ignorable="d"
        Title="Find Symbol" Height="440" Width="560"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Bg0Brush}">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,8" x:Name="CrossTradingPanel">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <TextBox x:Name="SearchBox"
                     Grid.Column="0"
                     Height="28"
                     Padding="6,4"
                     Background="{DynamicResource Bg2Brush}"
                     Foreground="{DynamicResource TextPrimaryBrush}"
                     BorderBrush="{DynamicResource Bg1Brush}"
                     TextChanged="SearchBox_TextChanged"/>

            <CheckBox x:Name="CrossTradingCheckBox"
                      Grid.Column="2"
                      Content="Enable Cross Trading"
                      Foreground="{DynamicResource TextPrimaryBrush}"
                      VerticalAlignment="Center"/>
        </Grid>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" x:Name="ChartSymbolColumn"/>
                <ColumnDefinition Width="12" x:Name="SpacerColumn"/>
                <ColumnDefinition Width="*" x:Name="CrossTradeColumn"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Grid.Column="0" Text="Chart Symbol" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,4"/>
            <TextBlock Grid.Row="0" Grid.Column="2" Text="Trade Symbol" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,4"/>

            <ListBox x:Name="ResultsList"
                     Grid.Row="1" Grid.Column="0"
                     MouseDoubleClick="ResultsList_MouseDoubleClick"/>

            <ListBox x:Name="CrossTradeSymbolList"
                     Grid.Row="1" Grid.Column="2"/>

            <Rectangle x:Name="CrossTradeOverlay"
                       Grid.Row="1" Grid.Column="2"
                       Fill="{DynamicResource Bg0Brush}"
                       Opacity="0.6"
                       IsHitTestVisible="True"/>
        </Grid>

        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,8,0,0">
            <Button x:Name="SelectButton"
                    Content="Select"
                    Width="80"
                    Padding="4"
                    Margin="0,0,8,0"
                    Click="SelectButton_Click"/>
            <Button x:Name="CancelButton"
                    Content="Cancel"
                    Width="80"
                    Padding="4"
                    Click="CancelButton_Click"/>
        </StackPanel>
    </Grid>
</Window>