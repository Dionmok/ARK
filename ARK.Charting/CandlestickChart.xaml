<UserControl x:Class="ARK.Charting.CandlestickChart"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:ARK.Charting"
             xmlns:skia="clr-namespace:SkiaSharp.Views.WPF;assembly=SkiaSharp.Views.WPF"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.Resources>
        <Style x:Key="HistoryScrollBarThumbStyle" TargetType="Thumb">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border Background="{DynamicResource Bg2Brush}" CornerRadius="2"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="HistoryScrollBarStyle" TargetType="ScrollBar">
            <Setter Property="Background" Value="{DynamicResource Bg1Brush}"/>
            <Setter Property="Height" Value="16"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="{TemplateBinding Background}">
                            <Track x:Name="PART_Track" IsDirectionReversed="False">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageLeftCommand" Opacity="0" IsTabStop="False"/>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageRightCommand" Opacity="0" IsTabStop="False"/>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource HistoryScrollBarThumbStyle}" MinWidth="20" Margin="0,3,0,3"/>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Menu Grid.Row="0" Background="{DynamicResource Bg2Brush}" Foreground="{DynamicResource TextPrimaryBrush}"
              Visibility="{Binding MenuVisibility, RelativeSource={RelativeSource AncestorType=UserControl}}">
            <MenuItem x:Name="FileMenu" Header="_File">
                <MenuItem Header="_New Chartbook" Click="NotImplemented_Click"/>
                <MenuItem Header="_Open Chartbook" Click="NotImplemented_Click"/>
                <MenuItem Header="_Close Chartbook" Click="NotImplemented_Click"/>
                <Separator/>
                <MenuItem Header="_Save Chartbook" Click="NotImplemented_Click"/>
                <MenuItem Header="Save Chartbook _As..." Click="NotImplemented_Click"/>
                <MenuItem Header="Save A_ll" Click="NotImplemented_Click"/>
                <Separator/>
                <MenuItem Header="_Find Symbol..." Click="NotImplemented_Click"/>
                <MenuItem Header="Clos_e Chart" Click="NotImplemented_Click"/>
                <Separator/>
                <MenuItem Header="S_ave Chart" Click="NotImplemented_Click"/>
                <MenuItem Header="Save C_hart As..." Click="NotImplemented_Click"/>
                <Separator/>
                <MenuItem Header="E_xit" Click="NotImplemented_Click"/>
            </MenuItem>
            <MenuItem Header="_Edit">
                <MenuItem Header="_Copy Chart Values" Click="NotImplemented_Click"/>
                <Separator/>
                <MenuItem Header="_Download Historical Data..." Click="NotImplemented_Click"/>
                <MenuItem Header="_Translate Symbols..." Click="NotImplemented_Click"/>
                <Separator/>
                <MenuItem Header="_Reload Chart" Click="NotImplemented_Click"/>
                <MenuItem Header="Edit C_hart..." Click="NotImplemented_Click"/>
                <Separator/>
                <MenuItem Header="_Preferences..." Click="NotImplemented_Click"/>
            </MenuItem>
            <MenuItem x:Name="ViewMenu" Header="_View">
                <MenuItem Header="_Time and Sales" Click="WindowAction_Click" Tag="{x:Static local:WindowAction.TimeAndSales}"/>
                <MenuItem Header="_DOM" Click="NotImplemented_Click"/>
            </MenuItem>
            <MenuItem Header="_Chart">
                <MenuItem Header="_Symbol..." Click="Symbol_Click"/>
                <MenuItem Header="St_udies..." Click="NotImplemented_Click"/>
                <MenuItem Header="Chart Se_ttings..." Click="WindowAction_Click" Tag="{x:Static local:WindowAction.ChartSettings}"/>
                <Separator/>
                <MenuItem Header="_Market Replay..." Click="NotImplemented_Click"/>
                <MenuItem Header="_Futures Roll Over..." Click="NotImplemented_Click"/>
                <Separator/>
                <MenuItem Header="_Lock Panning">
                    <MenuItem x:Name="LockHandPanningItem" Header="Lock Hand Panning" IsCheckable="True" Click="LockHandPanning_Click"/>
                    <MenuItem x:Name="LockFillSpaceItem" Header="Lock Fill Space" IsCheckable="True" Click="LockFillSpace_Click"/>
                </MenuItem>
                <Separator/>
                <MenuItem Header="_Duplicate Chart" Click="WindowAction_Click" Tag="{x:Static local:WindowAction.DuplicateChart}"/>
                <MenuItem Header="Duplicate Chart to Chart_book" Click="NotImplemented_Click"/>
            </MenuItem>
            <MenuItem x:Name="TradeMenu" Header="Tr_ade">
                <MenuItem Header="_Open Trade Window for Chart Symbol" Click="NotImplemented_Click"/>
                <Separator/>
            </MenuItem>
            <MenuItem Header="_Tools">
                <MenuItem Header="_Trend Line" Click="NotImplemented_Click"/>
                <MenuItem Header="_Horizontal Line" Click="NotImplemented_Click"/>
                <MenuItem Header="_Vertical Line" Click="NotImplemented_Click"/>
                <MenuItem Header="_Ray" Click="NotImplemented_Click"/>
                <MenuItem Header="Horizontal _Ray" Click="NotImplemented_Click"/>
                <MenuItem Header="E_xtended Line" Click="NotImplemented_Click"/>
                <Separator/>
                <MenuItem Header="Rec_tangle" Click="NotImplemented_Click"/>
                <MenuItem Header="Extended Rectan_gle" Click="NotImplemented_Click"/>
                <MenuItem Header="_Ellipse / Circle" Click="NotImplemented_Click"/>
                <Separator/>
                <MenuItem Header="_Fibonacci Retracement" Click="NotImplemented_Click"/>
                <MenuItem Header="Fibonacci E_xtension" Click="NotImplemented_Click"/>
                <MenuItem Header="_Gann Fan" Click="NotImplemented_Click"/>
                <MenuItem Header="_Pitchfork" Click="NotImplemented_Click"/>
                <MenuItem Header="_Anchored VWAP" Click="NotImplemented_Click"/>
                <MenuItem Header="Draw _Volume Profile" Click="NotImplemented_Click"/>
                <Separator/>
                <MenuItem Header="Te_xt / Annotation" Click="NotImplemented_Click"/>
                <MenuItem Header="_Arrow" Click="NotImplemented_Click"/>
                <MenuItem Header="_Measure Tool" Click="NotImplemented_Click"/>
                <Separator/>
                <MenuItem Header="Show B_uy" Click="NotImplemented_Click"/>
                <MenuItem Header="Show S_ell" Click="NotImplemented_Click"/>
                <Separator/>
                <MenuItem Header="_Delete All Drawings" Click="NotImplemented_Click"/>
            </MenuItem>
            <MenuItem Header="_Help">
                <MenuItem Header="_About ARK" Click="NotImplemented_Click"/>
            </MenuItem>
        </Menu>

        <skia:SKElement x:Name="SkCanvas"
                         Grid.Row="1"
                         PaintSurface="SkCanvas_PaintSurface"
                         MouseWheel="SkCanvas_MouseWheel"
                         MouseLeftButtonDown="SkCanvas_MouseLeftButtonDown"
                         MouseMove="SkCanvas_MouseMove"
                         MouseLeftButtonUp="SkCanvas_MouseLeftButtonUp"
                         MouseLeave="SkCanvas_MouseLeave"/>

        <ScrollBar x:Name="HistoryScrollBar"
                   Grid.Row="2"
                   Orientation="Horizontal"
                   Style="{StaticResource HistoryScrollBarStyle}"
                   Minimum="0"
                   SmallChange="1"
                   LargeChange="10"
                   ValueChanged="HistoryScrollBar_ValueChanged"/>
    </Grid>
</UserControl>
