<Window x:Class="ARK.App.QuoteboardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        mc:Ignorable="d"
        Title="Quoteboard" Height="500" Width="700"
        Background="{DynamicResource Bg0Brush}">
    <Grid Background="{DynamicResource Bg1Brush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Button Grid.Row="0"
                x:Name="FindSymbolButton"
                Content="Find Symbol..."
                HorizontalAlignment="Left"
                Padding="8,4"
                Margin="8"
                Click="FindSymbolButton_Click"/>

        <DataGrid Grid.Row="1"
                  x:Name="QuoteboardGrid"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  Background="{DynamicResource Bg1Brush}"
                  Foreground="{DynamicResource TextPrimaryBrush}"
                  RowBackground="{DynamicResource Bg1Brush}"
                  BorderThickness="0"
                  GridLinesVisibility="None">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Symbol" Binding="{Binding Symbol}" Width="*"/>
                <DataGridTextColumn Header="Last" Binding="{Binding Last}" Width="*"/>
                <DataGridTextColumn Header="Bid" Binding="{Binding Bid}" Width="*"/>
                <DataGridTextColumn Header="Ask" Binding="{Binding Ask}" Width="*"/>
                <DataGridTextColumn Header="Contract Volume" Binding="{Binding ContractVolume}" Width="*"/>
                <DataGridTemplateColumn Width="40">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Content="✕"
                                    Padding="4,0"
                                    Click="RemoveSymbol_Click"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Window>