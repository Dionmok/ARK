<Window x:Class="ARK.App.TimeAndSalesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        mc:Ignorable="d"
        Title="Time and Sales" Height="500" Width="719"
        Background="{DynamicResource Bg0Brush}">
    <Grid Background="{DynamicResource Bg1Brush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="8">
            <Button x:Name="FindSymbolButton"
                    Content="Find Symbol..."
                    Padding="8,4"
                    Click="FindSymbolButton_Click"/>
            <TextBlock x:Name="CurrentSymbolLabel"
                       Text="ES"
                       Foreground="{DynamicResource TextPrimaryBrush}"
                       FontWeight="Bold"
                       FontSize="14"
                       VerticalAlignment="Center"
                       Margin="12,0,0,0"/>
        </StackPanel>

        <DataGrid Grid.Row="1"
                  x:Name="TimeAndSalesGrid"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  Background="{DynamicResource Bg1Brush}"
                  Foreground="{DynamicResource TextPrimaryBrush}"
                  RowBackground="{DynamicResource Bg1Brush}"
                  BorderThickness="0"
                  GridLinesVisibility="None">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Date" Binding="{Binding MonthDay}" Width="*"/>
                <DataGridTextColumn Header="Time" Binding="{Binding Time}" Width="*"/>
                <DataGridTextColumn Header="Price" Binding="{Binding Price}" Width="*"/>
                <DataGridTextColumn Header="Volume" Binding="{Binding Volume}" Width="*"/>
                <DataGridTextColumn Header="# Trades" Binding="{Binding NumberOfTrades}" Width="*"/>
                <DataGridTextColumn Header="Type" Binding="{Binding Type}" Width="*">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Type}" Value="Buy">
                                    <Setter Property="Foreground" Value="#3DA35D"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Type}" Value="Sell">
                                    <Setter Property="Foreground" Value="#C94F4F"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="Bid" Binding="{Binding Bid}" Width="*"/>
                <DataGridTextColumn Header="Bid Size" Binding="{Binding BidSize}" Width="*"/>
                <DataGridTextColumn Header="Ask" Binding="{Binding Ask}" Width="*"/>
                <DataGridTextColumn Header="Ask Size" Binding="{Binding AskSize}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Window>