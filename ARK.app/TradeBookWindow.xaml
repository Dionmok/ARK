<Window x:Class="ARK.App.TradeBookWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        mc:Ignorable="d"
        Title="Trade Book" Height="650" Width="900"
        Background="{DynamicResource Bg0Brush}">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="Trade Book"
                   FontSize="18"
                   Foreground="{DynamicResource TextPrimaryBrush}"
                   Margin="0,0,0,12"/>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,12">
            <TextBlock Text="Start:" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
            <DatePicker x:Name="StartDatePicker" Width="120" SelectedDateChanged="DateRange_Changed"/>

            <TextBlock Text="End:" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" Margin="16,0,6,0"/>
            <DatePicker x:Name="EndDatePicker" Width="120" SelectedDateChanged="DateRange_Changed"/>

            <CheckBox x:Name="ContinuousCheckBox"
                      Content="Continuous (through today)"
                      Foreground="{DynamicResource TextPrimaryBrush}"
                      VerticalAlignment="Center"
                      Margin="16,0,0,0"
                      Checked="ContinuousCheckBox_Changed"
                      Unchecked="ContinuousCheckBox_Changed"/>

            <TextBlock Text="Account:" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" Margin="16,0,6,0"/>
            <ComboBox x:Name="AccountComboBox" Width="140" SelectionChanged="DateRange_Changed"/>
        </StackPanel>

        <Border Grid.Row="2"
                Background="{DynamicResource Bg1Brush}"
                BorderBrush="{DynamicResource Bg2Brush}"
                BorderThickness="1"
                Padding="12"
                Margin="0,0,0,12">
            <UniformGrid x:Name="StatsGrid" Columns="4" Rows="2"/>
        </Border>

        <Grid Grid.Row="3">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
                <TextBlock Text="View:" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <ComboBox x:Name="ViewModeComboBox" Width="140" SelectionChanged="ViewModeComboBox_SelectionChanged"/>
            </StackPanel>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="260"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                        Background="{DynamicResource Bg1Brush}"
                        BorderBrush="{DynamicResource Bg2Brush}"
                        BorderThickness="1"
                        Padding="12">
                    <ItemsControl x:Name="CalendarGrid"/>
                </Border>

                <Border Grid.Column="2"
                        Background="{DynamicResource Bg1Brush}"
                        BorderBrush="{DynamicResource Bg2Brush}"
                        BorderThickness="1"
                        Padding="12">
                    <StackPanel>
                        <TextBlock Text="Equity Curve"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   FontSize="13"
                                   FontWeight="Bold"
                                   Margin="0,0,0,8"/>
                        <ItemsControl x:Name="EquityCurveHost"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>
